# Supabase Credentials (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile Anti-Bot Protection (Required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Upstash Redis Distributed Rate Limiting (Required in production for fail-closed protection)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Transactional Email Provider (Resend for secure ownership transfer tokens)
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM="Royal Umrah Cabs Security <security@royalumrahcabs.com>"

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://royal-umrah-cabs.vercel.app
NEXT_PUBLIC_DEFAULT_WHATSAPP=966567588261
NEXT_PUBLIC_DEFAULT_PHONE=+966567588261
NEXT_PUBLIC_DEFAULT_EMAIL=info@royalumrahcabs.com
